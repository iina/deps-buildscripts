LIBARCHIVE_URL="https://github.com/libarchive/libarchive/releases/download/v${LIBARCHIVE_VERSION}/libarchive-${LIBARCHIVE_VERSION}.tar.xz"

# ---------------------------------------------------------------------------
# Layer 3 — Core media libraries
# ---------------------------------------------------------------------------

