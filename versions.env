FONTCONFIG_URL="https://gitlab.freedesktop.org/fontconfig/fontconfig/-/archive/${FONTCONFIG_VERSION}/fontconfig-${FONTCONFIG_VERSION}.tar.gz"

# libplacebo — GPU-accelerated video/image rendering; required by mpv
