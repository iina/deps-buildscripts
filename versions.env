# All dependency version pins with SHA256 checksums.
# SHA256s are sourced from Homebrew formula files and verified against upstream.
# To update a dependency: change VERSION, update SHA256, update URL if the URL
# pattern changed, then push to CI.

# ---------------------------------------------------------------------------
# Build tools (not shipped in output)
# ---------------------------------------------------------------------------

# nasm — assembler used by dav1d for architecture-specific optimisations
NASM_VERSION="2.16.03"
NASM_SHA256="5bc940dd8a4245686976a8f7e96ba9f1db5bc6b6b29b9f22df15b6b3ac7f882d"
NASM_URL="https://www.nasm.us/pub/nasm/releasebuilds/${NASM_VERSION}/nasm-${NASM_VERSION}.tar.xz"

# ---------------------------------------------------------------------------
# Layer 1 — Leaf libraries (no dependencies among themselves)
# ---------------------------------------------------------------------------

# libogg — base library for Ogg bitstream format; required by libvorbis
