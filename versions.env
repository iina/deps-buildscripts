LIBBLURAY_URL="https://download.videolan.org/videolan/libbluray/${LIBBLURAY_VERSION}/libbluray-${LIBBLURAY_VERSION}.tar.xz"

# libarchive — multi-format archive library; required by mpv -Dlibarchive=enabled
LIBARCHIVE_VERSION="3.8.7"
